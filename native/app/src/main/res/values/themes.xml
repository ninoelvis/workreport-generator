<?xml version="1.0" encoding="utf-8"?>
<!--
    ⚠️ 关于深浅色：请勿创建 `values-night/` 目录，也不要加 `values-night` 资源限定符。

    本 App 的深色模式是**在 App 内手动切换**的（ThemeMode.LIGHT / DARK / SYSTEM），
    跟系统的深浅色**不是一回事**：
      · 系统的 `values-night` 跟随的是**系统**深浅色，
        用户在 App 里选了「深色」而系统是浅色时，它根本不会生效；
      · 更糟的是，`enableEdgeToEdge()` 的**默认参数**也会按**系统**深浅色
        给导航条套一层浅色 scrim —— 深色模式下底部就会浮出一条白杠
        （v1.8.0 修过一次，见 Theme.kt / MainActivity.kt）。

    深色外观由 `Theme.WorkReport.Dark` 在**运行时**按 App 自己的主题切换，
    `GlassBottomBarTest` 里有防回归测试守着这条规则。
-->
<resources>
    <style name="Theme.WorkReport" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 深色版：窗口底色跟随深色，避免启动瞬间与切页时闪白。
         App 的深色模式是「App 内手动切换」的，系统的 values-night 跟不到，
         所以只能在这里提供一份运行时可切换的深色主题。 -->
    <style name="Theme.WorkReport.Dark" parent="Theme.WorkReport">
        <item name="android:windowBackground">@color/page_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.WorkReport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_bg</item>
        <!-- 启动图用**纯标志**那份：系统会把启动图标放大到画布 2/3，
     带小字会糊成一团。 -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.WorkReport</item>
    </style>

    <!-- 深色版启动图：启动瞬间也不闪白 -->
    <style name="Theme.WorkReport.Splash.Dark" parent="Theme.WorkReport.Splash">
        <item name="windowSplashScreenBackground">@color/page_bg_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.WorkReport.Dark</item>
    </style>
</resources>
