<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WorkReport" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.WorkReport.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.WorkReport</item>
    </style>
</resources>
